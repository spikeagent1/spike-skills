{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spike skill synthetic evals",
  "type": "object",
  "required": [
    "skill_name",
    "evals"
  ],
  "properties": {
    "skill_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "expected_output": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "assertions": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "id",
          "prompt",
          "assertions"
        ]
      }
    }
  }
}
